# Converted from nixos-config/modules/terminal/git.nix

[user]
	email = will.hutchinson@spellbook.com
	name = Will Hutchinson

[init]
	defaultBranch = main

[url "git@github.com:whutchinson98/"]
	insteadOf = gh:

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
